        <mxCell id="v4-note-379" parent="1" vertex="1" value="&amp;lt;b&amp;gt;CONSTRAINT UTAMA&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;UNIQUE target cabang: (cabang_id, tahun, bulan)&amp;lt;br&amp;gt;UNIQUE target user: (target_kinerja_cabang_id, user_id)&amp;lt;br&amp;gt;CHECK bulan 1–12, target/biaya/nominal ≥ 0, diskon 0–100" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;">
