        <mxCell id="v4-note-380" parent="1" vertex="1" value="&amp;lt;b&amp;gt;CATATAN IMPLEMENTASI&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;Gunakan foreign key dan index pada seluruh kolom FK. Atur ON DELETE sesuai kebutuhan bisnis. Status dan role dapat dipindahkan ke tabel referensi jika nilainya sering berubah." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;">
