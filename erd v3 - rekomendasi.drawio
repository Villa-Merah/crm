        <mxCell id="v4-note-378" parent="1" vertex="1" value="&amp;lt;b&amp;gt;GENERATED COLUMN — program_bimbel.nama_program&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;UPPER(CONCAT_WS(' ', kategori_program, program_kelas, tipe_program, metode_belajar, tingkat_kelas))&amp;lt;br&amp;gt;Contoh: SR GOLD INTENSIF ONLINE XII" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;">
