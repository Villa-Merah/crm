        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#64748B;align=center;verticalAlign=middle;whiteSpace=wrap;" value="Defense in depth untuk upload, penyimpanan, akses, webhook, dan observabilitas" vertex="1">
