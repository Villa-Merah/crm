        <mxCell id="d20-o5" value="&lt;b&gt;5. Tampilkan bubble&lt;/b&gt;&lt;br&gt;&lt;br&gt;Thumbnail atau video player&lt;br&gt;ACK: terkirim/diterima/dibaca" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=2;fontSize=20;fontColor=#334155;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
