        <mxCell id="d20-in-lane" value="INBOUND · WhatsApp → CRM" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;arcSize=8;fillColor=#EAFBF5;swimlaneFillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=18;" vertex="1" parent="1">
