        <mxCell id="subtitle" value="Alur outbound dari CRM dan inbound dari webhook dipisahkan agar retry serta kegagalan dapat ditangani" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontColor=#64748B;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="87" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="d20-out-lane" value="OUTBOUND · CRM → WhatsApp" style="swimlane;html=1;horizontal=1;startSize=48;rounded=1;arcSize=8;fillColor=#EAF4FB;swimlaneFillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;spacingLeft=18;" vertex="1" parent="1">
