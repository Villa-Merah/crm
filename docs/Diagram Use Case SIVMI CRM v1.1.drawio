        <mxCell id="p2-note" value="&lt;b&gt;Kontrol integrasi&lt;/b&gt;&lt;br&gt;REST API: bearer token, ability, rate limit, idempotency, request ID&lt;br&gt;WAHA: API key, HMAC webhook, session per user, dan deduplikasi message ID&lt;br&gt;Mutasi penting menghasilkan audit; pesan baru dan pengingat menghasilkan notifikasi." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF7E6;strokeColor=#F59E0B;fontSize=14;fontColor=#334155;spacing=10;" vertex="1" parent="p2-boundary"><mxGeometry x="210" y="820" width="770" height="120" as="geometry" /></mxCell>

