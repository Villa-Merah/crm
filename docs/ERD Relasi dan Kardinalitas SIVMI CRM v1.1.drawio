        <mxCell id="erd-06-subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=17;fontColor=#64748B;align=center;verticalAlign=middle;whiteSpace=wrap;" value="Ringkasan interpretasi relasi database SIVMI CRM" vertex="1">
          <mxGeometry height="40" width="1490" x="80" y="82" as="geometry" />
        </mxCell>
        <mxCell id="p6-left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;spacing=18;shadow=1;" value="&lt;b&gt;INDUK → ANAK | KARDINALITAS | CATATAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → users&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · users.cabang_id nullable&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · lead wajib satu cabang&lt;br&gt;&lt;br&gt;&lt;b&gt;sekolah&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · sekolah pada lead opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;program_bimbel&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · minat program opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · input wajib; PIC opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → followup_riwayat&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → followup_riwayat&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · pelaksana wajib&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → pendaftaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..1&lt;/b&gt;&lt;/font&gt; · lead_id unique&lt;br&gt;&lt;br&gt;&lt;b&gt;program_bimbel&lt;/b&gt; → pendaftaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · program wajib&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → pendaftaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cabang wajib&lt;br&gt;&lt;br&gt;&lt;b&gt;pendaftaran&lt;/b&gt; → pembayaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;" vertex="1">
          <mxGeometry height="720" width="740" x="60" y="160" as="geometry" />
