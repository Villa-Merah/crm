        <mxCell id="p6-right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;spacing=18;shadow=1;" value="&lt;b&gt;INDUK → ANAK | KARDINALITAS | CATATAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → target_kinerja_cabang&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · unik per bulan/tahun&lt;br&gt;&lt;br&gt;&lt;b&gt;target_kinerja_cabang&lt;/b&gt; → target_kinerja_user&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → target_kinerja_user&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · unik per target cabang&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → user_whatsapp_accounts&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..1&lt;/b&gt;&lt;/font&gt; · user_id unique&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → user_whatsapp_accounts&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · akun wajib satu cabang&lt;br&gt;&lt;br&gt;&lt;b&gt;user_whatsapp_accounts&lt;/b&gt; → whatsapp_conversations&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → whatsapp_conversations&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · FK pada conversation opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;whatsapp_conversations&lt;/b&gt; → whatsapp_messages&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → whatsapp_messages&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · FK pada message opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → imports / exports&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;imports&lt;/b&gt; → failed_import_rows&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;" vertex="1">
          <mxGeometry height="720" width="740" x="855" y="160" as="geometry" />
        </mxCell>
        <mxCell id="p6-legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0F9FF;strokeColor=#7DD3FC;strokeWidth=2;fontSize=15;fontColor=#334155;align=center;verticalAlign=middle;spacing=12;" value="&lt;b&gt;Notasi:&lt;/b&gt; 1 = tepat satu; 0..1 = opsional satu; 0..N = nol atau banyak. Garis penuh = foreign key database. Garis putus-putus = relasi logis atau polymorphic. UQ = unique constraint." vertex="1">
