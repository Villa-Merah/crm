  <diagram id="erd-06" name="06 - Matriks Relasi dan Kardinalitas">
    <mxGraphModel dx="1895" dy="1138" grid="0" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
