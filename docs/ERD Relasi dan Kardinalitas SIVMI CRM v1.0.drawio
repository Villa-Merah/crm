        <mxCell id="erd-06-title" value="Matriks Relasi dan Kardinalitas" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#075985;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="25" width="1560" height="48" as="geometry" />
        </mxCell>
        <mxCell id="erd-06-subtitle" value="Ringkasan interpretasi relasi database SIVMI CRM" style="text;html=1;strokeColor=none;fillColor=none;fontSize=17;fontColor=#64748B;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="80" y="82" width="1490" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p6-left" value="&lt;b&gt;INDUK → ANAK | KARDINALITAS | CATATAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → users&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · users.cabang_id nullable&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · lead wajib satu cabang&lt;br&gt;&lt;br&gt;&lt;b&gt;sekolah&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · sekolah pada lead opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;program_bimbel&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · minat program opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → leads&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · input wajib; PIC opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → followup_riwayat&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → followup_riwayat&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · pelaksana wajib&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → pendaftaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..1&lt;/b&gt;&lt;/font&gt; · lead_id unique&lt;br&gt;&lt;br&gt;&lt;b&gt;program_bimbel&lt;/b&gt; → pendaftaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · program wajib&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → pendaftaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cabang wajib&lt;br&gt;&lt;br&gt;&lt;b&gt;pendaftaran&lt;/b&gt; → pembayaran&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="740" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p6-right" value="&lt;b&gt;INDUK → ANAK | KARDINALITAS | CATATAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → target_kinerja_cabang&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · unik per bulan/tahun&lt;br&gt;&lt;br&gt;&lt;b&gt;target_kinerja_cabang&lt;/b&gt; → target_kinerja_user&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → target_kinerja_user&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · unik per target cabang&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → user_whatsapp_accounts&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..1&lt;/b&gt;&lt;/font&gt; · user_id unique&lt;br&gt;&lt;br&gt;&lt;b&gt;cabang&lt;/b&gt; → user_whatsapp_accounts&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · akun wajib satu cabang&lt;br&gt;&lt;br&gt;&lt;b&gt;user_whatsapp_accounts&lt;/b&gt; → whatsapp_conversations&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → whatsapp_conversations&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · FK pada conversation opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;whatsapp_conversations&lt;/b&gt; → whatsapp_messages&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;leads&lt;/b&gt; → whatsapp_messages&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · FK pada message opsional&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; → imports / exports&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;&lt;b&gt;imports&lt;/b&gt; → failed_import_rows&lt;br&gt;&lt;font color=&quot;#075985&quot;&gt;&lt;b&gt;1 : 0..N&lt;/b&gt;&lt;/font&gt; · cascade delete&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;fontSize=15;fontColor=#334155;align=left;verticalAlign=top;spacing=18;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="855" y="160" width="740" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p6-legend" value="&lt;b&gt;Notasi:&lt;/b&gt; 1 = tepat satu; 0..1 = opsional satu; 0..N = nol atau banyak. Garis penuh = foreign key database. Garis putus-putus = relasi logis atau polymorphic. UQ = unique constraint." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0F9FF;strokeColor=#7DD3FC;strokeWidth=2;fontSize=15;fontColor=#334155;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="210" y="935" width="1230" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
