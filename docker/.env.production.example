APP_NAME="SIVMI CRM"
APP_ENV=production
APP_KEY=GANTI_DENGAN_HASIL_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://crm.example.id
APP_PORT=8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_DATABASE=sivmi_crm
DB_USERNAME=sivmi
DB_PASSWORD=GANTI_PASSWORD_DATABASE_YANG_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_YANG_KUAT

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_PASSWORD=GANTI_PASSWORD_REDIS_YANG_KUAT

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.id
MAIL_PORT=587
MAIL_USERNAME=GANTI_USERNAME_SMTP
MAIL_PASSWORD=GANTI_PASSWORD_SMTP
MAIL_FROM_ADDRESS=noreply@example.id
MAIL_FROM_NAME="SIVMI CRM"

IMAGE_TAG=latest
WAHA_IMAGE=devlikeapro/waha
WAHA_BASE_URL=http://waha:3000
# Plain key hanya untuk aplikasi CRM; simpan melalui secret manager deployment.
WAHA_API_KEY=change-me
# Nilai WAHA_API_KEY_HASH harus berbentuk sha512:<128 karakter hex>.
WAHA_API_KEY_HASH=sha512:change-me
WAHA_WEBHOOK_URL=https://crm.example.com/api/webhooks/waha
WAHA_WEBHOOK_HMAC_SECRET=change-me-with-random-secret
WHATSAPP_AUTO_CREATE_LEAD=false

# Aktifkan sesudah security review, rate limit, dan API client produksi disiapkan.
PUBLIC_API_ENABLED=false
PUBLIC_API_RATE_LIMIT=60
WAHA_WEBHOOK_RATE_LIMIT=120
PUBLIC_API_MAX_PER_PAGE=100
PUBLIC_API_IDEMPOTENCY_TTL_HOURS=24
