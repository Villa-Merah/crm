APP_NAME="SIVMI CRM"
APP_ENV=local
# Ganti dengan key unik setelah file ini disalin menjadi docker/.env.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_PORT=8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_DATABASE=sivmi_crm
DB_USERNAME=sivmi
DB_PASSWORD=sivmi_local
DB_ROOT_PASSWORD=root_local
DB_FORWARD_PORT=3307

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
VITE_PORT=5173
VITE_DEV_SERVER_URL=http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sivmi.test"
MAIL_FROM_NAME="SIVMI CRM"

WAHA_IMAGE=devlikeapro/waha:gows
WAHA_PORT=3000
WAHA_BASE_URL=http://waha:3000
WAHA_API_KEY=sivmi-waha-local-change-me
WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_GODEBUG=netdns=go
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=sivmi-waha-dashboard-local-change-me
WAHA_WEBHOOK_URL=http://web/api/webhooks/waha
WAHA_WEBHOOK_HMAC_SECRET=sivmi-webhook-local-change-me
WHATSAPP_AUTO_CREATE_LEAD=false

# Public REST API lokal. Ubah menjadi true setelah migration dan api-client:create.
PUBLIC_API_ENABLED=false
PUBLIC_API_RATE_LIMIT=60
WAHA_WEBHOOK_RATE_LIMIT=120
PUBLIC_API_MAX_PER_PAGE=100
PUBLIC_API_IDEMPOTENCY_TTL_HOURS=24
